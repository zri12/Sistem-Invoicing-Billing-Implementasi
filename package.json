{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "prebuild": "node -e \"require('node:fs').rmSync('public/hot', { force: true })\"",
        "build": "node ./node_modules/vite/bin/vite.js build",
        "dev": "node ./node_modules/vite/bin/vite.js",
        "dev:all": "node ./node_modules/concurrently/dist/bin/concurrently.js -c \"#93c5fd,#c4b5fd,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1 --timeout=0\" \"npm run dev\" --names=server,queue,vite --kill-others"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "@vitejs/plugin-vue": "^6.0.8",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^2.0.0",
        "tailwindcss": "^4.0.0",
        "vite": "^7.0.7"
    },
    "dependencies": {
        "axios": "^1.20.0",
        "lucide-vue-next": "^0.468.0",
        "pinia": "^4.0.3",
        "vue": "^3.5.42",
        "vue-router": "^4.6.4"
    }
}
